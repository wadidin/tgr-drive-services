# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# PostgreSQL (Aiven Cloud — SSL Required)
DATABASE_URL="postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/defaultdb?sslmode=require"

# Auth JWT
JWT_ACCESS_SECRET="replace-with-random-64-char-secret"
JWT_REFRESH_SECRET="replace-with-random-64-char-secret"

# AES-256-GCM Master Key (64 hex chars = 32 bytes)
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-chars"

# Google OAuth2 (fototgr@gmail.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/admin/drive/oauth-callback"
GOOGLE_DEFAULT_FOLDER_ID="your-global-google-drive-folder-id"
